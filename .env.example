# Database Configuration
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=your_secure_password_here
DB_HOST=mysql:3306

# MySQL Root Password (for local development)
MYSQL_ROOT_PASSWORD=rootpassword

# WordPress URLs
# For Railway, use: https://your-app-name.up.railway.app
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Environment
WP_ENVIRONMENT_TYPE=production

# Debug Settings (set to false in production)
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false

# Optional runtime diagnostics (set to true only temporarily)
AIDDATA_RUNTIME_DIAGNOSTICS=false

# PHP error display toggles (container entrypoint)
PHP_DISPLAY_ERRORS=Off
PHP_DISPLAY_STARTUP_ERRORS=Off

# Cron Settings
DISABLE_WP_CRON=false

# Outbound HTTP control
WP_HTTP_BLOCK_EXTERNAL=false
# Comma-separated host allowlist when WP_HTTP_BLOCK_EXTERNAL=true
WP_ACCESSIBLE_HOSTS=api.wordpress.org

# Update behavior
AUTOMATIC_UPDATER_DISABLED=false
WP_AUTO_UPDATE_CORE=minor

# Optional SMTP settings for transactional emails (welcome/reset/etc.)
# If AIDDATA_SMTP_HOST is empty, WordPress falls back to default mail transport.
# Transport options:
# - wp_mail (default): uses WordPress mailer (SMTP if SMTP vars are set)
# - resend: uses Resend HTTPS API (recommended when SMTP ports are blocked)
# - sendgrid: uses SendGrid HTTPS API (Single Sender flow can work without DNS access)
AIDDATA_MAIL_TRANSPORT=wp_mail

# SMTP transport settings
AIDDATA_SMTP_HOST=
AIDDATA_SMTP_PORT=587
AIDDATA_SMTP_USER=
AIDDATA_SMTP_PASS=
# tls or ssl
AIDDATA_SMTP_SECURE=tls
AIDDATA_SMTP_FROM_EMAIL=
AIDDATA_SMTP_FROM_NAME=AidData Training Hub

# Resend API transport settings
AIDDATA_RESEND_API_KEY=
AIDDATA_RESEND_FROM_EMAIL=
AIDDATA_RESEND_FROM_NAME=AidData Training Hub

# SendGrid API transport settings
AIDDATA_SENDGRID_API_KEY=
AIDDATA_SENDGRID_FROM_EMAIL=
AIDDATA_SENDGRID_FROM_NAME=AidData Training Hub

# WordPress Security Keys
# Generate new keys at: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=your_unique_auth_key
SECURE_AUTH_KEY=your_unique_secure_auth_key
LOGGED_IN_KEY=your_unique_logged_in_key
NONCE_KEY=your_unique_nonce_key
AUTH_SALT=your_unique_auth_salt
SECURE_AUTH_SALT=your_unique_secure_auth_salt
LOGGED_IN_SALT=your_unique_logged_in_salt
NONCE_SALT=your_unique_nonce_salt
WP_CACHE_KEY_SALT=your_unique_cache_key_salt
